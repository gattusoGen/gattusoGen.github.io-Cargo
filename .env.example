PORT=5000
NODE_ENV=production
APP_URL=https://store.example.com
FRONTEND_ORIGIN=https://store.example.com

JWT_SECRET=generate-a-long-random-production-secret
ADMIN_USERNAME=replace-me
ADMIN_PASSWORD=replace-me
ADMIN_EMAIL=admin@example.com

STORE_NAME=CARGO
STORE_PHONE=+27000000000
STORE_EMAIL=support@example.com
FREE_SHIPPING_THRESHOLD=1500
DEFAULT_SHIPPING_FEE=150

PAYFAST_SANDBOX=false
PAYFAST_MERCHANT_ID=replace-me
PAYFAST_MERCHANT_KEY=replace-me
PAYFAST_PASSPHRASE=replace-me

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASS=replace-me
SMTP_FROM=CARGO <orders@example.com>
